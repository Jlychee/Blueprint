          "rawSql": "SELECT\n  \"CohortDate\"::timestamp AS \"time\",\n  'R7' AS metric,\n  ROUND(100.0 * \"r7D\"::numeric / NULLIF(\"Users\", 0), 2) AS value\nFROM public.\"RetentionByCohorts\"\nWHERE \"CohortDate\" >= $__timeFrom()::date\n  AND \"CohortDate\" <= $__timeTo()::date\nUNION ALL\nSELECT\n  \"CohortDate\"::timestamp AS \"time\",\n  'R14' AS metric,\n  ROUND(100.0 * \"r14D\"::numeric / NULLIF(\"Users\", 0), 2) AS value\nFROM public.\"RetentionByCohorts\"\nWHERE \"CohortDate\" >= $__timeFrom()::date\n  AND \"CohortDate\" <= $__timeTo()::date\nUNION ALL\nSELECT\n  \"CohortDate\"::timestamp AS \"time\",\n  'R30' AS metric,\n  ROUND(100.0 * \"r30D\"::numeric / NULLIF(\"Users\", 0), 2) AS value\nFROM public.\"RetentionByCohorts\"\nWHERE \"CohortDate\" >= $__timeFrom()::date\n  AND \"CohortDate\" <= $__timeTo()::date\nORDER BY 1, 2;",
