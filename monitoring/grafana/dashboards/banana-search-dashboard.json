          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH search_sessions AS (\n  SELECT DISTINCT \"FilterSessionId\"\n  FROM public.\"FilteredViews\"\n  WHERE $__timeFilter(\"OpenedAtUtc\")\n), project_sessions AS (\n  SELECT DISTINCT \"FilterSessionId\"\n  FROM public.\"FilteredProjectViews\"\n  WHERE $__timeFilter(\"OpenedAtUtc\")\n    AND \"HasFilter\" = TRUE\n)\nSELECT COALESCE(\n  ROUND(\n    COUNT(project_sessions.\"FilterSessionId\")::numeric\n    / NULLIF(COUNT(search_sessions.\"FilterSessionId\"), 0),\n  4),\n  0\n) AS value\nFROM search_sessions\nLEFT JOIN project_sessions USING (\"FilterSessionId\");",
