          "rawSql": "WITH session_pages AS (\n  SELECT date_trunc('day', \"OpenedAtUtc\") AS day,\n         \"FilterSessionId\",\n         COUNT(DISTINCT \"Page\") AS page_count\n  FROM public.\"FilteredViews\"\n  WHERE $__timeFilter(\"OpenedAtUtc\")\n  GROUP BY 1, 2\n)\nSELECT day AS time,\n       ROUND(AVG(page_count)::numeric, 2) AS \"Ср. страниц / сессия\",\n       COUNT(*) AS \"Сессии\"\nFROM session_pages\nGROUP BY 1\nORDER BY 1;",
