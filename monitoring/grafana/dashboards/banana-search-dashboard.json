          "rawSql": "WITH search_sessions AS (\n  SELECT MIN(fv.\"OpenedAtUtc\") AS \"StartedAt\",\n         fv.\"UserId\",\n         fv.\"FilterSessionId\",\n         COUNT(DISTINCT fv.\"Page\") AS \"PagesViewed\"\n  FROM public.\"FilteredViews\" fv\n  WHERE $__timeFilter(fv.\"OpenedAtUtc\")\n  GROUP BY fv.\"UserId\", fv.\"FilterSessionId\"\n), project_counts AS (\n  SELECT fpv.\"FilterSessionId\",\n         COUNT(*) FILTER (WHERE fpv.\"HasFilter\" = TRUE) AS \"ProjectsOpened\"\n  FROM public.\"FilteredProjectViews\" fpv\n  WHERE $__timeFilter(fpv.\"OpenedAtUtc\")\n  GROUP BY fpv.\"FilterSessionId\"\n)\nSELECT\n  ss.\"StartedAt\" AS \"Начало\",\n  ss.\"UserId\" AS \"UserId\",\n  ss.\"FilterSessionId\" AS \"FilterSessionId\",\n  ss.\"PagesViewed\" AS \"Просмотрено страниц\",\n  COALESCE(pc.\"ProjectsOpened\", 0) AS \"Открыто проектов\",\n  CASE WHEN ss.\"PagesViewed\" >= 2 THEN 'да' ELSE 'нет' END AS \"Дошел до 2+ страниц\",\n  CASE WHEN COALESCE(pc.\"ProjectsOpened\", 0) > 0 THEN 'да' ELSE 'нет' END AS \"Открыл проект\"\nFROM search_sessions ss\nLEFT JOIN project_counts pc ON pc.\"FilterSessionId\" = ss.\"FilterSessionId\"\nORDER BY ss.\"StartedAt\" DESC;",
          "refId": "A"
        }
      ],
      "title": "Детализация поисковых сессий",
      "type": "table"
    }
  ],
