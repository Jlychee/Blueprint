          "rawSql": "WITH search_sessions AS (\n  SELECT DISTINCT \"FilterSessionId\"\n  FROM public.\"FilteredViews\"\n  WHERE $__timeFilter(\"OpenedAtUtc\")\n), session_project_counts AS (\n  SELECT s.\"FilterSessionId\",\n         COUNT(fpv.\"Id\") AS open_count\n  FROM search_sessions s\n  LEFT JOIN public.\"FilteredProjectViews\" fpv\n    ON fpv.\"FilterSessionId\" = s.\"FilterSessionId\"\n   AND fpv.\"HasFilter\" = TRUE\n  GROUP BY s.\"FilterSessionId\"\n)\nSELECT COALESCE(ROUND(AVG(open_count)::numeric, 2), 0) AS value\nFROM session_project_counts;",
