          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH weekly AS (\n  SELECT date_trunc('week', \"OpenedAtUtc\") AS week,\n         COUNT(*) AS project_opens,\n         COUNT(DISTINCT \"ProjectId\") AS unique_projects,\n         COUNT(DISTINCT \"UserId\") AS users\n  FROM public.\"FilteredProjectViews\"\n  WHERE $__timeFilter(\"OpenedAtUtc\")\n    AND \"HasFilter\" = TRUE\n  GROUP BY 1\n)\nSELECT week AS time,\n       project_opens AS \"Открытия проектов\",\n       unique_projects AS \"Уникальные проекты\",\n       users AS \"Пользователи\"\nFROM weekly\nORDER BY 1;",
