        "code": {
          "language": "markdown",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "### Метрики Banana API\nЦель Prometheus scrape: `backend:8080/metrics`\nПериод: ${__from:date:DD.MM.YYYY HH:mm} - ${__to:date:DD.MM.YYYY HH:mm}\n\nМедиана: типичное время ответа.\n95-й перцентиль: почти все запросы укладываются в это время, кроме самых медленных 5%.\n99-й перцентиль: почти самые медленные запросы.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "title": "Обзор",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "banana-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "banana-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
